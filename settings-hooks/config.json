{
  "lintChanged": {
    "enabled": true,
    "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"],
    "baseline": true,
    "includeWarnings": false,
    "timeoutMs": 45000,
    "maxReported": 15,
    "stopGate": true
  },
  "eolGuard": {
    "enabled": false,
    "maxBytes": 5000000,
    "maxFilesAfterBash": 300
  },
  "jiraPrefetch": {
    "enabled": true,
    "site": "",
    "cloudId": "",
    "projects": [],
    "maxIssues": 3,
    "cacheMinutes": 30,
    "maxChars": 9000,
    "timeoutMs": 7000,
    "skipWhenPromptHas": ["/jira-plan"]
  },
  "gitGuard": {
    "enabled": true,
    "setAutoSetupRemote": true
  },
  "statusline": {
    "ports": [],
    "portCacheSeconds": 10,
    "showModel": true,
    "maxBranchLength": 42
  }
}
